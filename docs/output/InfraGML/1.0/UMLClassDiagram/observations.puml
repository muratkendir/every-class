' Class relations (promoted from property wrappers)
"liso:GnssObservation" ..> "0..1" "liso:GnssQuality" : quality
"liso:GnssObservation" ..> "0..1" "liso:RtkInfo" : rtkInfo
"liso:GnssObservation" ..> "0..*" "liso:SatelliteInfo" : satInfo
"liso:ImageObservation" ..> "0..1" "liso:ExteriorOrientation" : exteriorOrientation
"liso:PanoramaImage" ..> "1..*" "liso:ImageObservation" : image
"liso:Setup" o-- "0..1" "liso:InstrumentPoint" : instrumentPoint
"liso:Setup" o-- "0..1" "liso:PanoramaImage" : panoImage
"liso:SurveyObservation" ..> "0..*" "liso:ImageObservation" : image
"liso:SurveyObservation" o-- "0..1" "liso:PanoramaImage" : panoImage

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

