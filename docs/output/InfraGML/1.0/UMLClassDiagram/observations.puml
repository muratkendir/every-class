' External types (unresolved namespaces)
abstract class "gml:AbstractGML"
class "gml:Observation"
class "li:Feature"

"liso:SurveyObservation" <|-- "liso:AngularObservation"
"liso:SurveyObservation" <|-- "liso:DistanceObservation"
