@startuml
title
  GML - 3.2.1 - Datums - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractDatum" as gml_AbstractDatum <<ObjectType>> {
  domainOfValidity : gml:domainOfValidity [0..1]
  scope : gml:scope [1..*]
  anchorDefinition : gml:anchorDefinition [0..1]
  realizationEpoch : gml:realizationEpoch [0..1]
}
class "gml:DatumProperty" as gml_DatumProperty $property {
  AbstractDatum : gml:AbstractDatum
}
class "gml:GeodeticDatum" as gml_GeodeticDatum <<ObjectType>> {
  primeMeridian : gml:primeMeridian
  ellipsoid : gml:ellipsoid
}
class "gml:GeodeticDatumProperty" as gml_GeodeticDatumProperty $property {
  GeodeticDatum : gml:GeodeticDatum
}
class "gml:Ellipsoid" as gml_Ellipsoid <<ObjectType>> {
  semiMajorAxis : gml:semiMajorAxis
  secondDefiningParameter : gml:secondDefiningParameter
}
class "gml:EllipsoidProperty" as gml_EllipsoidProperty $property {
  Ellipsoid : gml:Ellipsoid
}
class "gml:PrimeMeridian" as gml_PrimeMeridian <<ObjectType>> {
  greenwichLongitude : gml:greenwichLongitude
}
class "gml:PrimeMeridianProperty" as gml_PrimeMeridianProperty $property {
  PrimeMeridian : gml:PrimeMeridian
}
class "gml:EngineeringDatum" as gml_EngineeringDatum <<ObjectType>>
class "gml:EngineeringDatumProperty" as gml_EngineeringDatumProperty $property {
  EngineeringDatum : gml:EngineeringDatum
}
class "gml:ImageDatum" as gml_ImageDatum <<ObjectType>> {
  pixelInCell : gml:pixelInCell
}
class "gml:ImageDatumProperty" as gml_ImageDatumProperty $property {
  ImageDatum : gml:ImageDatum
}
class "gml:VerticalDatum" as gml_VerticalDatum <<ObjectType>>
class "gml:VerticalDatumProperty" as gml_VerticalDatumProperty $property {
  VerticalDatum : gml:VerticalDatum
}
class "gml:TemporalDatum" as gml_TemporalDatum <<ObjectType>> {
  origin : gml:origin
}
abstract class "gml:TemporalDatumBase" as gml_TemporalDatumBase <<ObjectType>> {
  metaDataProperty : gml:metaData [0..*]
  description : gml:description [0..1]
  descriptionReference : gml:descriptionReference [0..1]
  identifier : gml:identifier
  name : gml:name [0..*]
  remarks : gml:remarks [0..1]
  domainOfValidity : gml:domainOfValidity [0..1]
  scope : gml:scope [1..*]
}
class "gml:TemporalDatumProperty" as gml_TemporalDatumProperty $property {
  TemporalDatum : gml:TemporalDatum
}
}

' External types (unresolved namespaces)
class "gml:IdentifiedObject" as gml_IdentifiedObject

"gml_IdentifiedObject" <|-- "gml_AbstractDatum"
"gml_AbstractDatum" <|-- "gml_GeodeticDatum"
"gml_IdentifiedObject" <|-- "gml_Ellipsoid"
"gml_IdentifiedObject" <|-- "gml_PrimeMeridian"
"gml_AbstractDatum" <|-- "gml_EngineeringDatum"
"gml_AbstractDatum" <|-- "gml_ImageDatum"
"gml_AbstractDatum" <|-- "gml_VerticalDatum"
"gml_TemporalDatumBase" <|-- "gml_TemporalDatum"
"gml_AbstractDatum" <|-- "gml_TemporalDatumBase"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

