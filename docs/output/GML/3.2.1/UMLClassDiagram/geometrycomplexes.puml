@startuml
title
  GML - 3.2.1 - Geometrycomplexes - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:GeometricComplex" as gml_GeometricComplex <<ObjectType>> {
  element : gml:GeometricPrimitive [1..*]
}
class "gml:GeometricComplexProperty" as gml_GeometricComplexProperty $property {
  GeometricComplex : gml:GeometricComplex
  CompositeCurve : gml:CompositeCurve
  CompositeSurface : gml:CompositeSurface
  CompositeSolid : gml:CompositeSolid
}
class "gml:CompositeCurve" as gml_CompositeCurve <<ObjectType>> {
  curveMember : gml:curveMember [1..*]
}
class "gml:CompositeSurface" as gml_CompositeSurface <<ObjectType>> {
  surfaceMember : gml:surfaceMember [1..*]
}
class "gml:CompositeSolid" as gml_CompositeSolid <<ObjectType>> {
  solidMember : gml:solidMember [1..*]
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractCurve" as gml_AbstractCurve
abstract class "gml:AbstractGeometry" as gml_AbstractGeometry
abstract class "gml:AbstractSolid" as gml_AbstractSolid
abstract class "gml:AbstractSurface" as gml_AbstractSurface

"gml_AbstractGeometry" <|-- "gml_GeometricComplex"
"gml_AbstractCurve" <|-- "gml_CompositeCurve"
"gml_AbstractSurface" <|-- "gml_CompositeSurface"
"gml_AbstractSolid" <|-- "gml_CompositeSolid"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
