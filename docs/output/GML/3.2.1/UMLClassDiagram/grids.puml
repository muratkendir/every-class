package gml {
class "gml:Grid" as gml_Grid <<ObjectType>> {
  limits : gml:GridLimits
  axisLabels : gml:NCNameList
  # axisName : xs:string [1..*]
}
class "gml:GridLimits" as gml_GridLimits <<DataType>> {
  GridEnvelope : gml:GridEnvelope
}
class "gml:GridEnvelope" as gml_GridEnvelope <<DataType>> {
  low : gml:integerList
  high : gml:integerList
}
class "gml:RectifiedGrid" as gml_RectifiedGrid <<ObjectType>> {
  origin : gml:Point
  offsetVector : gml:Vector [1..*]
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGeometry" as gml_AbstractGeometry

"gml_AbstractGeometry" <|-- "gml_Grid"
"gml_Grid" <|-- "gml_RectifiedGrid"

