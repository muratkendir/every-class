}
class "gml:TimeCalendarProperty" as gml_TimeCalendarProperty $property {
  TimeCalendar : gml:TimeCalendar
}
class "gml:TimeCalendarEraProperty" as gml_TimeCalendarEraProperty $property {
  TimeCalendarEra : gml:TimeCalendarEra
}
class "gml:TimeClock" as gml_TimeClock <<ObjectType>> {
  referenceEvent : gml:StringOrRef
  # referenceTime : xs:time
  # utcReference : xs:time
}
class "gml:TimeClockProperty" as gml_TimeClockProperty $property {
  TimeClock : gml:TimeClock
}
class "gml:TimeOrdinalReferenceSystem" as gml_TimeOrdinalReferenceSystem <<ObjectType>>
class "gml:TimeOrdinalEra" as gml_TimeOrdinalEra <<ObjectType>> {
  relatedTime : gml:RelatedTime [0..*]
  start : gml:TimeNode [0..1]
  end : gml:TimeNode [0..1]
  extent : gml:TimePeriod [0..1]
  group : gml:Reference [0..1]
}
class "gml:TimeOrdinalEraProperty" as gml_TimeOrdinalEraProperty $property {
  TimeOrdinalEra : gml:TimeOrdinalEra
}
}

