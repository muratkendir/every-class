package gml {
class "gml:TimeReferenceSystem" as gml_TimeReferenceSystem <<ObjectType>> {
  # domainOfValidity : xs:string
}
class "gml:TimeCoordinateSystem" as gml_TimeCoordinateSystem <<ObjectType>> {
  originPosition : gml:TimePosition
