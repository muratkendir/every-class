@startuml
title
  GML - 3.2.1 - Valueobjects - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:ValueProperty" as gml_ValueProperty $property
class "gml:ValueArrayProperty" as gml_ValueArrayProperty $property
class "gml:CompositeValue" as gml_CompositeValue <<ObjectType>> {
  valueComponent : gml:valueComponent [0..*]
  valueComponents : gml:valueComponents [0..1]
}
class "gml:ValueArray" as gml_ValueArray <<ObjectType>>
class "gml:CategoryExtent" as gml_CategoryExtent <<DataType>>
class "gml:QuantityExtent" as gml_QuantityExtent <<DataType>>
class "gml:BooleanProperty" as gml_BooleanProperty $property {
  Boolean : gml:Boolean
}
class "gml:CategoryProperty" as gml_CategoryProperty $property {
  Category : gml:Category
}
class "gml:QuantityProperty" as gml_QuantityProperty $property {
  Quantity : gml:Quantity
}
class "gml:CountProperty" as gml_CountProperty $property {
  Count : gml:Count
}

' Simple types (from <simpleType> declarations)
class "gml:CountExtent" as gml_CountExtent <<BasicType>>

' Model groups (from <group> declarations)
class "gml:Value" as gml_Value <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML" as gml_AbstractGML

"gml_AbstractGML" <|-- "gml_CompositeValue"
"gml_CompositeValue" <|-- "gml_ValueArray"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
