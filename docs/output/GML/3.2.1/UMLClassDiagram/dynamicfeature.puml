@startuml
title
  GML - 3.2.1 - Dynamicfeature - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:DynamicFeature" <<FeatureType>>
class "gml:DynamicFeatureCollection" <<FeatureType>> {
  dynamicMembers : gml:dynamicMembers
}
class "gml:DynamicFeatureMember" <<ObjectType>> {
  DynamicFeature : gml:DynamicFeature [0..*]
}
abstract class "gml:AbstractTimeSlice" <<ObjectType>> {
  validTime : gml:validTime
  dataSource : gml:dataSource [0..1]
}
class "gml:HistoryProperty" $property {
  AbstractTimeSlice : gml:AbstractTimeSlice [1..*]
}

' Model groups (from <group> declarations)
class "gml:dynamicProperties" <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractFeature"
abstract class "gml:AbstractFeatureMember"
abstract class "gml:AbstractGML"

"gml:AbstractFeature" <|-- "gml:DynamicFeature"
"gml:DynamicFeature" <|-- "gml:DynamicFeatureCollection"
"gml:AbstractFeatureMember" <|-- "gml:DynamicFeatureMember"
"gml:AbstractGML" <|-- "gml:AbstractTimeSlice"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-08-03 13:11:00
@enduml
