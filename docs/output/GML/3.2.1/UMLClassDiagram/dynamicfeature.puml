@startuml
title
  GML - 3.2.1 - Dynamicfeature - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:DynamicFeature" as gml_DynamicFeature <<FeatureType>>
class "gml:DynamicFeatureCollection" as gml_DynamicFeatureCollection <<FeatureType>> {
  dynamicMembers : gml:dynamicMembers
}
class "gml:DynamicFeatureMember" as gml_DynamicFeatureMember <<ObjectType>> {
  DynamicFeature : gml:DynamicFeature [0..*]
}
abstract class "gml:AbstractTimeSlice" as gml_AbstractTimeSlice <<ObjectType>> {
  validTime : gml:validTime
  dataSource : gml:dataSource [0..1]
}
class "gml:HistoryProperty" as gml_HistoryProperty $property {
  AbstractTimeSlice : gml:AbstractTimeSlice [1..*]
}

' Model groups (from <group> declarations)
class "gml:dynamicProperties" as gml_dynamicProperties <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractFeature" as gml_AbstractFeature
abstract class "gml:AbstractFeatureMember" as gml_AbstractFeatureMember
abstract class "gml:AbstractGML" as gml_AbstractGML

"gml_AbstractFeature" <|-- "gml_DynamicFeature"
"gml_DynamicFeature" <|-- "gml_DynamicFeatureCollection"
"gml_AbstractFeatureMember" <|-- "gml_DynamicFeatureMember"
"gml_AbstractGML" <|-- "gml_AbstractTimeSlice"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
