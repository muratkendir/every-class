@startuml
title
  GML - 3.2.1 - Deprecatedtypes - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:OperationProperty" as gml_OperationProperty $property {
  AbstractOperation : gml:AbstractOperation
}
class "gml:TemporalCS" as gml_TemporalCS <<ObjectType>>
class "gml:TemporalCSProperty" as gml_TemporalCSProperty $property {
  TemporalCS : gml:TemporalCS
}
class "gml:ObliqueCartesianCS" as gml_ObliqueCartesianCS <<ObjectType>>
class "gml:ObliqueCartesianCSProperty" as gml_ObliqueCartesianCSProperty $property {
  ObliqueCartesianCS : gml:ObliqueCartesianCS
}
class "gml:GeographicCRS" as gml_GeographicCRS <<ObjectType>> {
  usesEllipsoidalCS : gml:usesEllipsoidalCS
  usesGeodeticDatum : gml:usesGeodeticDatum
}
class "gml:GeographicCRSProperty" as gml_GeographicCRSProperty $property {
  GeographicCRS : gml:GeographicCRS
}
class "gml:GeocentricCRS" as gml_GeocentricCRS <<ObjectType>> {
  usesCartesianCS : gml:usesCartesianCS
  usesSphericalCS : gml:usesSphericalCS
  usesGeodeticDatum : gml:usesGeodeticDatum
}
class "gml:GeocentricCRSProperty" as gml_GeocentricCRSProperty $property {
  GeocentricCRS : gml:GeocentricCRS
}
class "gml:DMSAngle" as gml_DMSAngle <<DataType>> {
  degrees : gml:degrees
  decimalMinutes : gml:decimalMinutes
  minutes : gml:minutes
  seconds : gml:seconds [0..1]
}
class "gml:Degrees" as gml_Degrees <<DataType>>
class "gml:AngleChoice" as gml_AngleChoice <<DataType>> {
  angle : gml:angle
  dmsAngle : gml:dmsAngle
}
class "gml:ArrayAssociation" as gml_ArrayAssociation <<DataType>> {
  AbstractObject : gml:AbstractObject [0..*]
}
class "gml:StringOrRef" as gml_StringOrRef <<DataType>>
class "gml:Bag" as gml_Bag <<ObjectType>> {
  member : gml:member [0..*]
  members : gml:members [0..1]
}
class "gml:Array" as gml_Array <<ObjectType>> {
  members : gml:members [0..1]
}
class "gml:MetaDataProperty" as gml_MetaDataProperty $property {
  AbstractMetaData : gml:AbstractMetaData
}
abstract class "gml:AbstractMetaData" as gml_AbstractMetaData <<DataType>>
class "gml:GenericMetaData" as gml_GenericMetaData <<ObjectType>>
class "gml:LocationProperty" as gml_LocationProperty $property {
  AbstractGeometry : gml:AbstractGeometry
  LocationKeyWord : gml:LocationKeyWord
  LocationString : gml:LocationString
  Null : gml:Null
}
class "gml:PriorityLocationProperty" as gml_PriorityLocationProperty $property
class "gml:FeatureArrayProperty" as gml_FeatureArrayProperty $property {
  AbstractFeature : gml:AbstractFeature
}
abstract class "gml:BoundedFeature" as gml_BoundedFeature <<FeatureType>> {
  boundedBy : gml:boundedBy
  location : gml:location [0..1]
}
abstract class "gml:AbstractFeatureCollection" as gml_AbstractFeatureCollection <<FeatureType>> {
  featureMember : gml:featureMember [0..*]
  featureMembers : gml:featureMembers [0..1]
}
class "gml:FeatureCollection" as gml_FeatureCollection <<FeatureType>>
class "gml:IndirectEntry" as gml_IndirectEntry <<DataType>> {
  DefinitionProxy : gml:DefinitionProxy
}
class "gml:DefinitionProxy" as gml_DefinitionProxy <<ObjectType>> {
  definitionRef : gml:definitionRef
}
class "gml:MovingObjectStatus" as gml_MovingObjectStatus <<ObjectType>> {
  position : gml:Geometry
  pos : gml:pos
  locationName : gml:locationName
  locationReference : gml:locationReference
  location : gml:location
  speed : gml:Measure [0..1]
  bearing : gml:Direction [0..1]
  acceleration : gml:Measure [0..1]
  elevation : gml:Measure [0..1]
  status : gml:status [0..1]
  statusReference : gml:statusReference [0..1]
}

' Simple types (from <simpleType> declarations)
class "gml:Succession" as gml_Succession <<Enumeration>> {
  substitution
  division
  fusion
  initiation
}
class "gml:DegreeValue" as gml_DegreeValue <<BasicType>>
class "gml:DecimalMinutes" as gml_DecimalMinutes <<BasicType>>
class "gml:ArcMinutes" as gml_ArcMinutes <<BasicType>>
class "gml:ArcSeconds" as gml_ArcSeconds <<BasicType>>
class "gml:IncrementOrder" as gml_IncrementOrder <<Enumeration>> {
  +x+y
  +y+x
  +x-y
  -x-y
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractCRS" as gml_AbstractCRS
abstract class "gml:AbstractCoordinateSystem" as gml_AbstractCoordinateSystem
abstract class "gml:AbstractFeature" as gml_AbstractFeature
abstract class "gml:AbstractGML" as gml_AbstractGML
abstract class "gml:AbstractTimeSlice" as gml_AbstractTimeSlice
class "gml:Definition" as gml_Definition

"gml_AbstractCoordinateSystem" <|-- "gml_TemporalCS"
"gml_AbstractCoordinateSystem" <|-- "gml_ObliqueCartesianCS"
"gml_AbstractCRS" <|-- "gml_GeographicCRS"
"gml_AbstractCRS" <|-- "gml_GeocentricCRS"
"gml_AbstractGML" <|-- "gml_Bag"
"gml_AbstractGML" <|-- "gml_Array"
"gml_AbstractMetaData" <|-- "gml_GenericMetaData"
"gml_LocationProperty" <|-- "gml_PriorityLocationProperty"
"gml_AbstractFeature" <|-- "gml_BoundedFeature"
"gml_AbstractFeature" <|-- "gml_AbstractFeatureCollection"
"gml_AbstractFeatureCollection" <|-- "gml_FeatureCollection"
"gml_Definition" <|-- "gml_DefinitionProxy"
"gml_AbstractTimeSlice" <|-- "gml_MovingObjectStatus"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

