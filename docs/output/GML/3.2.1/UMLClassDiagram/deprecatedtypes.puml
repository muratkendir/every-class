@startuml
title
  GML - 3.2.1 - Deprecatedtypes - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:OperationProperty" $property {
  AbstractOperation : gml:AbstractOperation
}
class "gml:TemporalCS" <<ObjectType>>
class "gml:TemporalCSProperty" $property {
  TemporalCS : gml:TemporalCS
}
class "gml:ObliqueCartesianCS" <<ObjectType>>
class "gml:ObliqueCartesianCSProperty" $property {
  ObliqueCartesianCS : gml:ObliqueCartesianCS
}
class "gml:GeographicCRS" <<ObjectType>> {
  usesEllipsoidalCS : gml:usesEllipsoidalCS
  usesGeodeticDatum : gml:usesGeodeticDatum
}
class "gml:GeographicCRSProperty" $property {
  GeographicCRS : gml:GeographicCRS
}
class "gml:GeocentricCRS" <<ObjectType>> {
  usesCartesianCS : gml:usesCartesianCS
  usesSphericalCS : gml:usesSphericalCS
  usesGeodeticDatum : gml:usesGeodeticDatum
}
class "gml:GeocentricCRSProperty" $property {
  GeocentricCRS : gml:GeocentricCRS
}
class "gml:DMSAngle" <<DataType>> {
  degrees : gml:degrees
  decimalMinutes : gml:decimalMinutes
  minutes : gml:minutes
  seconds : gml:seconds [0..1]
}
class "gml:Degrees" <<DataType>>
class "gml:AngleChoice" <<DataType>> {
  angle : gml:angle
  dmsAngle : gml:dmsAngle
}
class "gml:ArrayAssociation" <<DataType>> {
  AbstractObject : gml:AbstractObject [0..*]
}
class "gml:StringOrRef" <<DataType>>
class "gml:Bag" <<ObjectType>> {
  member : gml:member [0..*]
  members : gml:members [0..1]
}
class "gml:Array" <<ObjectType>> {
  members : gml:members [0..1]
}
class "gml:MetaDataProperty" $property {
  AbstractMetaData : gml:AbstractMetaData
}
abstract class "gml:AbstractMetaData" <<DataType>>
class "gml:GenericMetaData" <<ObjectType>>
class "gml:LocationProperty" $property {
  AbstractGeometry : gml:AbstractGeometry
  LocationKeyWord : gml:LocationKeyWord
  LocationString : gml:LocationString
  Null : gml:Null
}
class "gml:PriorityLocationProperty" $property
class "gml:FeatureArrayProperty" $property {
  AbstractFeature : gml:AbstractFeature
}
abstract class "gml:BoundedFeature" <<FeatureType>> {
  boundedBy : gml:boundedBy
  location : gml:location [0..1]
}
abstract class "gml:AbstractFeatureCollection" <<FeatureType>> {
  featureMember : gml:featureMember [0..*]
  featureMembers : gml:featureMembers [0..1]
}
class "gml:FeatureCollection" <<FeatureType>>
class "gml:IndirectEntry" <<DataType>> {
  DefinitionProxy : gml:DefinitionProxy
}
class "gml:DefinitionProxy" <<ObjectType>> {
  definitionRef : gml:definitionRef
}
class "gml:MovingObjectStatus" <<ObjectType>> {
  position : gml:Geometry
  pos : gml:pos
  locationName : gml:locationName
  locationReference : gml:locationReference
  location : gml:location
  speed : gml:Measure [0..1]
  bearing : gml:Direction [0..1]
  acceleration : gml:Measure [0..1]
  elevation : gml:Measure [0..1]
  status : gml:status [0..1]
  statusReference : gml:statusReference [0..1]
}

' Simple types (from <simpleType> declarations)
class "gml:Succession" <<Enumeration>> {
  substitution
  division
  fusion
  initiation
}
class "gml:DegreeValue" <<BasicType>>
class "gml:DecimalMinutes" <<BasicType>>
class "gml:ArcMinutes" <<BasicType>>
class "gml:ArcSeconds" <<BasicType>>
class "gml:IncrementOrder" <<Enumeration>> {
  +x+y
  +y+x
  +x-y
  -x-y
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractCRS"
abstract class "gml:AbstractCoordinateSystem"
abstract class "gml:AbstractFeature"
abstract class "gml:AbstractGML"
abstract class "gml:AbstractTimeSlice"
class "gml:Definition"

"gml:AbstractCoordinateSystem" <|-- "gml:TemporalCS"
"gml:AbstractCoordinateSystem" <|-- "gml:ObliqueCartesianCS"
"gml:AbstractCRS" <|-- "gml:GeographicCRS"
"gml:AbstractCRS" <|-- "gml:GeocentricCRS"
"gml:AbstractGML" <|-- "gml:Bag"
"gml:AbstractGML" <|-- "gml:Array"
"gml:AbstractMetaData" <|-- "gml:GenericMetaData"
"gml:LocationProperty" <|-- "gml:PriorityLocationProperty"
"gml:AbstractFeature" <|-- "gml:BoundedFeature"
"gml:AbstractFeature" <|-- "gml:AbstractFeatureCollection"
"gml:AbstractFeatureCollection" <|-- "gml:FeatureCollection"
"gml:Definition" <|-- "gml:DefinitionProxy"
"gml:AbstractTimeSlice" <|-- "gml:MovingObjectStatus"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-08-03 13:11:00
@enduml
