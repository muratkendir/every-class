}
class "gml:GeometryArrayProperty" as gml_GeometryArrayProperty $property {
  AbstractGeometry : gml:AbstractGeometry
}
class "gml:DirectPosition" as gml_DirectPosition <<DataType>>
class "gml:DirectPositionList" as gml_DirectPositionList <<DataType>>
class "gml:Vector" as gml_Vector <<DataType>>
class "gml:Envelope" as gml_Envelope <<DataType>> {
  lowerCorner : gml:DirectPosition
  upperCorner : gml:DirectPosition
