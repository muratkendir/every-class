}
class "gml:PointProperty" as gml_PointProperty $property {
  Point : gml:Point
}
class "gml:PointArrayProperty" as gml_PointArrayProperty $property {
  Point : gml:Point
}
abstract class "gml:AbstractCurve" as gml_AbstractCurve <<ObjectType>>
class "gml:CurveProperty" as gml_CurveProperty $property {
  AbstractCurve : gml:AbstractCurve
}
class "gml:CurveArrayProperty" as gml_CurveArrayProperty $property {
  AbstractCurve : gml:AbstractCurve
}
class "gml:LineString" as gml_LineString <<ObjectType>> {
  pos : gml:pos
  pointProperty : gml:point
  pointRep : gml:pointRep
  posList : gml:posList
  coordinates : gml:coordinates
}

' Model groups (from <group> declarations)
class "gml:geometricPosition" as gml_geometricPosition <<Union>>
class "gml:geometricPositionList" as gml_geometricPositionList <<Union>>
