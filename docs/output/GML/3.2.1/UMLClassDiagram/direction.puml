@startuml
title
  GML - 3.2.1 - Direction - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:DirectionProperty" $property {
  DirectionVector : gml:DirectionVector
  DirectionDescription : gml:DirectionDescription
  CompassPoint : gml:CompassPointEnumeration
  DirectionKeyword : gml:Code
  DirectionString : gml:StringOrRef
}
class "gml:DirectionVector" <<DataType>> {
  vector : gml:vector
  horizontalAngle : gml:Angle
  verticalAngle : gml:Angle
}
class "gml:DirectionDescription" <<DataType>> {
  compassPoint : gml:CompassPointEnumeration
  keyword : gml:Code
  # description : xs:string
  reference : gml:Reference
}

' Simple types (from <simpleType> declarations)
class "gml:CompassPointEnumeration" <<Enumeration>> {
  N
  NNE
  NE
  ENE
  E
  ESE
  SE
  SSE
  S
  SSW
  SW
  WSW
  W
  WNW
  NW
  NNW
}
}


' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

footer Generated on 2026-08-03 13:11:00
@enduml
