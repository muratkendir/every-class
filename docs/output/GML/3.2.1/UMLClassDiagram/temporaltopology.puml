@startuml
title
  GML - 3.2.1 - Temporaltopology - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractTimeTopologyPrimitive" as gml_AbstractTimeTopologyPrimitive <<ObjectType>> {
  complex : gml:Reference [0..1]
}
class "gml:TimeTopologyPrimitiveProperty" as gml_TimeTopologyPrimitiveProperty $property {
  AbstractTimeTopologyPrimitive : gml:AbstractTimeTopologyPrimitive
}
abstract class "gml:TimeTopologyComplex" as gml_TimeTopologyComplex <<ObjectType>>
class "gml:TimeTopologyComplexProperty" as gml_TimeTopologyComplexProperty $property {
  TimeTopologyComplex : gml:TimeTopologyComplex
}
class "gml:TimeNode" as gml_TimeNode <<ObjectType>> {
  position : gml:TimeInstant [0..1]
}
class "gml:TimeNodeProperty" as gml_TimeNodeProperty $property {
  TimeNode : gml:TimeNode
}
class "gml:TimeEdge" as gml_TimeEdge <<ObjectType>> {
  extent : gml:TimePeriod [0..1]
}
class "gml:TimeEdgeProperty" as gml_TimeEdgeProperty $property {
  TimeEdge : gml:TimeEdge
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractTimeComplex" as gml_AbstractTimeComplex
abstract class "gml:AbstractTimePrimitive" as gml_AbstractTimePrimitive

"gml_AbstractTimePrimitive" <|-- "gml_AbstractTimeTopologyPrimitive"
"gml_AbstractTimeComplex" <|-- "gml_TimeTopologyComplex"
"gml_AbstractTimeTopologyPrimitive" <|-- "gml_TimeNode"
"gml_AbstractTimeTopologyPrimitive" <|-- "gml_TimeEdge"

' Class relations (promoted from property wrappers)
"gml_TimeTopologyComplex" ..> "1..*" "gml_AbstractTimeTopologyPrimitive" : primitive
"gml_TimeNode" ..> "0..*" "gml_TimeEdge" : previousEdge
"gml_TimeNode" ..> "0..*" "gml_TimeEdge" : nextEdge
"gml_TimeEdge" ..> "1" "gml_TimeNode" : start
"gml_TimeEdge" ..> "1" "gml_TimeNode" : end

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

