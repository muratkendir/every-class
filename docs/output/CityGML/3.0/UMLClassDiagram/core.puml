@startuml
title
  CityGML - 3.0 - Core - Only XSD based
  http://www.opengis.net/citygml/3.0
end title

package core {
abstract class "core:ADEOfAbstractAppearance" $adeOf
class "core:ADEOfAbstractAppearanceProperty" $property $adeOf {
  ADEOfAbstractAppearance : core:ADEOfAbstractAppearance
}
abstract class "core:ADEOfAbstractCityObject" $adeOf
class "core:ADEOfAbstractCityObjectProperty" $property $adeOf {
  ADEOfAbstractCityObject : core:ADEOfAbstractCityObject
}
abstract class "core:ADEOfAbstractDynamizer" $adeOf
class "core:ADEOfAbstractDynamizerProperty" $property $adeOf {
  ADEOfAbstractDynamizer : core:ADEOfAbstractDynamizer
}
abstract class "core:ADEOfAbstractFeature" $adeOf
class "core:ADEOfAbstractFeatureProperty" $property $adeOf {
  ADEOfAbstractFeature : core:ADEOfAbstractFeature
}
abstract class "core:ADEOfAbstractFeatureWithLifespan" $adeOf
class "core:ADEOfAbstractFeatureWithLifespanProperty" $property $adeOf {
  ADEOfAbstractFeatureWithLifespan : core:ADEOfAbstractFeatureWithLifespan
}
abstract class "core:ADEOfAbstractLogicalSpace" $adeOf
class "core:ADEOfAbstractLogicalSpaceProperty" $property $adeOf {
  ADEOfAbstractLogicalSpace : core:ADEOfAbstractLogicalSpace
}
abstract class "core:ADEOfAbstractOccupiedSpace" $adeOf
