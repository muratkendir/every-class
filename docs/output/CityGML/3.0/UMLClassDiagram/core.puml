  ADEOfAbstractPhysicalSpace : core:ADEOfAbstractPhysicalSpace
}
abstract class "core:ADEOfAbstractPointCloud" $adeOf
class "core:ADEOfAbstractPointCloudProperty" $property $adeOf {
  ADEOfAbstractPointCloud : core:ADEOfAbstractPointCloud
}
abstract class "core:ADEOfAbstractSpace" $adeOf
class "core:ADEOfAbstractSpaceProperty" $property $adeOf {
  ADEOfAbstractSpace : core:ADEOfAbstractSpace
}
abstract class "core:ADEOfAbstractSpaceBoundary" $adeOf
class "core:ADEOfAbstractSpaceBoundaryProperty" $property $adeOf {
  ADEOfAbstractSpaceBoundary : core:ADEOfAbstractSpaceBoundary
}
abstract class "core:ADEOfAbstractThematicSurface" $adeOf
class "core:ADEOfAbstractThematicSurfaceProperty" $property $adeOf {
  ADEOfAbstractThematicSurface : core:ADEOfAbstractThematicSurface
}
abstract class "core:ADEOfAbstractUnoccupiedSpace" $adeOf
class "core:ADEOfAbstractUnoccupiedSpaceProperty" $property $adeOf {
  ADEOfAbstractUnoccupiedSpace : core:ADEOfAbstractUnoccupiedSpace
}
abstract class "core:ADEOfAbstractVersion" $adeOf
class "core:ADEOfAbstractVersionProperty" $property $adeOf {
  ADEOfAbstractVersion : core:ADEOfAbstractVersion
}
abstract class "core:ADEOfAbstractVersionTransition" $adeOf
class "core:ADEOfAbstractVersionTransitionProperty" $property $adeOf {
  ADEOfAbstractVersionTransition : core:ADEOfAbstractVersionTransition
}
abstract class "core:ADEOfAddress" $adeOf
class "core:ADEOfAddressProperty" $property $adeOf {
  ADEOfAddress : core:ADEOfAddress
}
abstract class "core:ADEOfCityModel" $adeOf
class "core:ADEOfCityModelProperty" $property $adeOf {
  ADEOfCityModel : core:ADEOfCityModel
}
abstract class "core:ADEOfClosureSurface" $adeOf
class "core:ADEOfClosureSurfaceProperty" $property $adeOf {
  ADEOfClosureSurface : core:ADEOfClosureSurface
}
abstract class "core:AbstractAppearance" <<FeatureType>> {
  ~ adeOfAbstractAppearance : core:ADEOfAbstractAppearance [0..*]
}
class "core:AbstractAppearanceProperty" $property {
  AbstractAppearance : core:AbstractAppearance
}
abstract class "core:AbstractCityObject" <<FeatureType>> {
  relativeToTerrain : core:RelativeToTerrain [0..1]
  relativeToWater : core:RelativeToWater [0..1]
  ~ adeOfAbstractCityObject : core:ADEOfAbstractCityObject [0..*]
  - externalReference : core:ExternalReference [0..*]
}
class "core:AbstractCityObjectProperty" $property {
  AbstractCityObject : core:AbstractCityObject
}
abstract class "core:AbstractDynamizer" <<FeatureType>> {
  ~ adeOfAbstractDynamizer : core:ADEOfAbstractDynamizer [0..*]
}
class "core:AbstractDynamizerProperty" $property {
  AbstractDynamizer : core:AbstractDynamizer
}
abstract class "core:AbstractFeature" <<FeatureType>> {
  ~ adeOfAbstractFeature : core:ADEOfAbstractFeature [0..*]
}
class "core:AbstractFeatureProperty" $property {
  AbstractFeature : core:AbstractFeature
}
abstract class "core:AbstractFeatureWithLifespan" <<FeatureType>> {
  # creationDate : xs:dateTime [0..1]
  # terminationDate : xs:dateTime [0..1]
  # validFrom : xs:dateTime [0..1]
  # validTo : xs:dateTime [0..1]
  ~ adeOfAbstractFeatureWithLifespan : core:ADEOfAbstractFeatureWithLifespan [0..*]
}
class "core:AbstractFeatureWithLifespanProperty" $property {
  AbstractFeatureWithLifespan : core:AbstractFeatureWithLifespan
}
abstract class "core:AbstractGenericAttribute" <<DataType>>
class "core:AbstractGenericAttributeProperty" $property {
  AbstractGenericAttribute : core:AbstractGenericAttribute
}
abstract class "core:AbstractLogicalSpace" <<FeatureType>> {
  ~ adeOfAbstractLogicalSpace : core:ADEOfAbstractLogicalSpace [0..*]
}
class "core:AbstractLogicalSpaceProperty" $property {
