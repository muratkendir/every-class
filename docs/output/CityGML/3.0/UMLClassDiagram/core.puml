}
abstract class "core:AbstractOccupiedSpace" <<FeatureType>> {
  ~ adeOfAbstractOccupiedSpace : core:ADEOfAbstractOccupiedSpace [0..*]
}
class "core:AbstractOccupiedSpaceProperty" $property {
  AbstractOccupiedSpace : core:AbstractOccupiedSpace
}
abstract class "core:AbstractPhysicalSpace" <<FeatureType>> {
  # lod1TerrainIntersectionCurve : gml:MultiCurve [0..1]
  # lod2TerrainIntersectionCurve : gml:MultiCurve [0..1]
  # lod3TerrainIntersectionCurve : gml:MultiCurve [0..1]
  ~ adeOfAbstractPhysicalSpace : core:ADEOfAbstractPhysicalSpace [0..*]
}
class "core:AbstractPhysicalSpaceProperty" $property {
  AbstractPhysicalSpace : core:AbstractPhysicalSpace
}
abstract class "core:AbstractPointCloud" <<FeatureType>> {
  ~ adeOfAbstractPointCloud : core:ADEOfAbstractPointCloud [0..*]
}
class "core:AbstractPointCloudProperty" $property {
  AbstractPointCloud : core:AbstractPointCloud
}
abstract class "core:AbstractSpace" <<FeatureType>> {
  spaceType : core:SpaceType [0..1]
  # lod0Point : gml:Point [0..1]
  # lod0MultiSurface : gml:MultiSurface [0..1]
  # lod0MultiCurve : gml:MultiCurve [0..1]
  # lod1Solid : gml:Solid [0..1]
  # lod2Solid : gml:Solid [0..1]
  # lod2MultiSurface : gml:MultiSurface [0..1]
  # lod2MultiCurve : gml:MultiCurve [0..1]
  # lod3Solid : gml:Solid [0..1]
  # lod3MultiSurface : gml:MultiSurface [0..1]
  # lod3MultiCurve : gml:MultiCurve [0..1]
  ~ adeOfAbstractSpace : core:ADEOfAbstractSpace [0..*]
  - volume : core:QualifiedVolume [0..*]
  - area : core:QualifiedArea [0..*]
}
class "core:AbstractSpaceProperty" $property {
  AbstractSpace : core:AbstractSpace
}
abstract class "core:AbstractSpaceBoundary" <<FeatureType>> {
  ~ adeOfAbstractSpaceBoundary : core:ADEOfAbstractSpaceBoundary [0..*]
}
class "core:AbstractSpaceBoundaryProperty" $property {
  AbstractSpaceBoundary : core:AbstractSpaceBoundary
}
abstract class "core:AbstractThematicSurface" <<FeatureType>> {
  # lod0MultiCurve : gml:MultiCurve [0..1]
  # lod0MultiSurface : gml:MultiSurface [0..1]
  # lod1MultiSurface : gml:MultiSurface [0..1]
  # lod2MultiSurface : gml:MultiSurface [0..1]
  # lod3MultiSurface : gml:MultiSurface [0..1]
  ~ adeOfAbstractThematicSurface : core:ADEOfAbstractThematicSurface [0..*]
  - area : core:QualifiedArea [0..*]
}
class "core:AbstractThematicSurfaceProperty" $property {
  AbstractThematicSurface : core:AbstractThematicSurface
}
abstract class "core:AbstractUnoccupiedSpace" <<FeatureType>> {
  ~ adeOfAbstractUnoccupiedSpace : core:ADEOfAbstractUnoccupiedSpace [0..*]
}
class "core:AbstractUnoccupiedSpaceProperty" $property {
  AbstractUnoccupiedSpace : core:AbstractUnoccupiedSpace
}
abstract class "core:AbstractVersion" <<FeatureType>> {
  ~ adeOfAbstractVersion : core:ADEOfAbstractVersion [0..*]
}
class "core:AbstractVersionProperty" $property {
  AbstractVersion : core:AbstractVersion
}
abstract class "core:AbstractVersionTransition" <<FeatureType>> {
  ~ adeOfAbstractVersionTransition : core:ADEOfAbstractVersionTransition [0..*]
}
class "core:AbstractVersionTransitionProperty" $property {
  AbstractVersionTransition : core:AbstractVersionTransition
}
class "core:Address" <<FeatureType>> {
  # xalAddress : xAL:Address
  # multiPoint : gml:MultiPoint [0..1]
  ~ adeOfAddress : core:ADEOfAddress [0..*]
}
class "core:AddressProperty" $property {
  Address : core:Address
}
class "core:CityModel" <<FeatureType>> {
  # engineeringCRS : gml:EngineeringCRS [0..1]
  ~ adeOfCityModel : core:ADEOfCityModel [0..*]
}
class "core:CityModelProperty" $property {
  CityModel : core:CityModel
}
class "core:CityObjectRelation" <<ObjectType>> {
  # relationType : gml:Code
}
class "core:CityObjectRelationProperty" $property {
  CityObjectRelation : core:CityObjectRelation
}
class "core:ClosureSurface" <<FeatureType>> {
  ~ adeOfClosureSurface : core:ADEOfClosureSurface [0..*]
}
class "core:ClosureSurfaceProperty" $property {
  ClosureSurface : core:ClosureSurface
}
class "core:ExternalReference" <<DataType>> {
  # targetResource : xs:anyURI
  # informationSystem : xs:anyURI [0..1]
  # relationType : xs:anyURI [0..1]
}
class "core:ExternalReferenceProperty" $property {
  ExternalReference : core:ExternalReference
}
class "core:ImplicitGeometry" <<ObjectType>> {
  transformationMatrix : core:TransformationMatrix4x4
  # mimeType : gml:Code [0..1]
  # libraryObject : xs:anyURI [0..1]
  # referencePoint : gml:Point
  # relativeGeometry : gml:Geometry [0..1]
}
class "core:ImplicitGeometryProperty" $property {
  ImplicitGeometry : core:ImplicitGeometry
}
class "core:Occupancy" <<DataType>> {
  # numberOfOccupants : xs:integer
  # interval : gml:Code [0..1]
  # occupantType : gml:Code [0..1]
}
class "core:OccupancyProperty" $property {
  Occupancy : core:Occupancy
}
class "core:QualifiedArea" <<DataType>> {
  # area : gml:Area
  # typeOfArea : gml:Code
}
class "core:QualifiedAreaProperty" $property {
  QualifiedArea : core:QualifiedArea
}
class "core:QualifiedVolume" <<DataType>> {
  # volume : gml:Volume
  # typeOfVolume : gml:Code
}
class "core:QualifiedVolumeProperty" $property {
  QualifiedVolume : core:QualifiedVolume
}

' Simple types (from <simpleType> declarations)
class "core:DoubleBetween0and1" <<BasicType>>
class "core:IntegerBetween0and3" <<BasicType>>
class "core:RelativeToTerrain" <<Enumeration>> {
  entirelyAboveTerrain
  substantiallyAboveTerrain
  substantiallyAboveAndBelowTerrain
  substantiallyBelowTerrain
  entirelyBelowTerrain
}
class "core:RelativeToWater" <<Enumeration>> {
  entirelyAboveWaterSurface
  substantiallyAboveWaterSurface
  substantiallyAboveAndBelowWaterSurface
  substantiallyBelowWaterSurface
  entirelyBelowWaterSurface
  temporarilyAboveAndBelowWaterSurface
}
class "core:SpaceType" <<Enumeration>> {
  closed
  open
  semiOpen
}
class "core:TransformationMatrix2x2" <<BasicType>>
class "core:TransformationMatrix3x4" <<BasicType>>
class "core:TransformationMatrix4x4" <<BasicType>>

' Model groups (from <group> declarations)
class "core:CityModelMember" <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractFeature"
abstract class "gml:AbstractGML"

"core:AbstractFeatureWithLifespan" <|-- "core:AbstractAppearance"
"core:AbstractFeatureWithLifespan" <|-- "core:AbstractCityObject"
"core:AbstractFeatureWithLifespan" <|-- "core:AbstractDynamizer"
"gml:AbstractFeature" <|-- "core:AbstractFeature"
"core:AbstractFeature" <|-- "core:AbstractFeatureWithLifespan"
"core:AbstractSpace" <|-- "core:AbstractLogicalSpace"
"core:AbstractPhysicalSpace" <|-- "core:AbstractOccupiedSpace"
"core:AbstractSpace" <|-- "core:AbstractPhysicalSpace"
"core:AbstractFeature" <|-- "core:AbstractPointCloud"
"core:AbstractCityObject" <|-- "core:AbstractSpace"
"core:AbstractCityObject" <|-- "core:AbstractSpaceBoundary"
"core:AbstractSpaceBoundary" <|-- "core:AbstractThematicSurface"
"core:AbstractPhysicalSpace" <|-- "core:AbstractUnoccupiedSpace"
"core:AbstractFeatureWithLifespan" <|-- "core:AbstractVersion"
"core:AbstractFeatureWithLifespan" <|-- "core:AbstractVersionTransition"
"core:AbstractFeature" <|-- "core:Address"
"core:AbstractFeatureWithLifespan" <|-- "core:CityModel"
"gml:AbstractGML" <|-- "core:CityObjectRelation"
"core:AbstractThematicSurface" <|-- "core:ClosureSurface"
"gml:AbstractGML" <|-- "core:ImplicitGeometry"

' Class relations (promoted from property wrappers)
"core:AbstractCityObject" ..> "0..*" "core:AbstractCityObject" : generalizesTo
"core:AbstractCityObject" "1" *-- "0..*" "core:CityObjectRelation" : relatedTo
"core:AbstractCityObject" o-- "0..*" "core:AbstractAppearance" : appearance
"core:AbstractCityObject" "1" *-- "0..*" "core:AbstractGenericAttribute" : genericAttribute
"core:AbstractCityObject" o-- "0..*" "core:AbstractDynamizer" : dynamizer
"core:AbstractOccupiedSpace" ..> "0..1" "core:ImplicitGeometry" : lod1ImplicitRepresentation
"core:AbstractOccupiedSpace" ..> "0..1" "core:ImplicitGeometry" : lod2ImplicitRepresentation
"core:AbstractOccupiedSpace" ..> "0..1" "core:ImplicitGeometry" : lod3ImplicitRepresentation
"core:AbstractPhysicalSpace" o-- "0..1" "core:AbstractPointCloud" : pointCloud
"core:AbstractSpace" o-- "0..*" "core:AbstractSpaceBoundary" : boundary
"core:AbstractThematicSurface" o-- "0..1" "core:AbstractPointCloud" : pointCloud
"core:CityModel" o-- "0..*" "core:AbstractCityObject" : cityObjectMember
"core:CityModel" o-- "0..*" "core:AbstractAppearance" : appearanceMember
"core:CityModel" o-- "0..*" "core:AbstractVersion" : versionMember
"core:CityModel" o-- "0..*" "core:AbstractVersionTransition" : versionTransitionMember
"core:CityModel" o-- "0..*" "core:AbstractFeature" : featureMember
"core:CityObjectRelation" "1" *-- "0..*" "core:AbstractGenericAttribute" : genericAttribute
"core:CityObjectRelation" ..> "1" "core:AbstractCityObject" : relatedTo
"core:ImplicitGeometry" o-- "0..*" "core:AbstractAppearance" : appearance

' ADE hook classes are removed from rendering by default;
' remove the next line to show them.
remove $adeOf

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' ADE hook attributes are marked as package members (~ ) and
' hidden from rendering by default; remove the next line to show them.
hide package members

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

@enduml
