package pcl {
abstract class "pcl:ADEOfPointCloud" $adeOf
class "pcl:ADEOfPointCloudProperty" $property $adeOf {
  ADEOfPointCloud : pcl:ADEOfPointCloud
}
class "pcl:PointCloud" <<FeatureType>> {
  # mimeType : gml:Code [0..1]
  # pointFile : xs:anyURI [0..1]
  # pointFileSrsName : xs:string [0..1]
  # points : gml:MultiPoint [0..1]
  ~ adeOfPointCloud : pcl:ADEOfPointCloud [0..*]
}
class "pcl:PointCloudProperty" $property {
  PointCloud : pcl:PointCloud
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractPointCloud"

"core:AbstractPointCloud" <|-- "pcl:PointCloud"

' ADE hook classes are removed from rendering by default;
