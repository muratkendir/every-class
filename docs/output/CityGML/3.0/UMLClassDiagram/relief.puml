@startuml
title
  CityGML - 3.0 - Relief - Only XSD based
  http://www.opengis.net/citygml/relief/3.0
end title

package dem {
abstract class "dem:ADEOfAbstractReliefComponent" $adeOf
class "dem:ADEOfAbstractReliefComponentProperty" $property $adeOf {
  ADEOfAbstractReliefComponent : dem:ADEOfAbstractReliefComponent
}
abstract class "dem:ADEOfBreaklineRelief" $adeOf
class "dem:ADEOfBreaklineReliefProperty" $property $adeOf {
  ADEOfBreaklineRelief : dem:ADEOfBreaklineRelief
}
abstract class "dem:ADEOfMassPointRelief" $adeOf
class "dem:ADEOfMassPointReliefProperty" $property $adeOf {
  ADEOfMassPointRelief : dem:ADEOfMassPointRelief
}
abstract class "dem:ADEOfRasterRelief" $adeOf
class "dem:ADEOfRasterReliefProperty" $property $adeOf {
  ADEOfRasterRelief : dem:ADEOfRasterRelief
}
abstract class "dem:ADEOfReliefFeature" $adeOf
class "dem:ADEOfReliefFeatureProperty" $property $adeOf {
  ADEOfReliefFeature : dem:ADEOfReliefFeature
}
abstract class "dem:ADEOfTINRelief" $adeOf
class "dem:ADEOfTINReliefProperty" $property $adeOf {
  ADEOfTINRelief : dem:ADEOfTINRelief
}
abstract class "dem:AbstractReliefComponent" <<FeatureType>> {
  # lod : core:IntegerBetween0and3
  # extent : gml:Surface [0..1]
  ~ adeOfAbstractReliefComponent : dem:ADEOfAbstractReliefComponent [0..*]
}
class "dem:AbstractReliefComponentProperty" $property {
  AbstractReliefComponent : dem:AbstractReliefComponent
}
class "dem:BreaklineRelief" <<FeatureType>> {
  # ridgeOrValleyLines : gml:MultiCurve [0..1]
  # breaklines : gml:MultiCurve [0..1]
  ~ adeOfBreaklineRelief : dem:ADEOfBreaklineRelief [0..*]
}
class "dem:BreaklineReliefProperty" $property {
  BreaklineRelief : dem:BreaklineRelief
}
class "dem:MassPointRelief" <<FeatureType>> {
  # reliefPoints : gml:MultiPoint [0..1]
  # pointCloud : core:AbstractPointCloud [0..1]
  ~ adeOfMassPointRelief : dem:ADEOfMassPointRelief [0..*]
}
class "dem:MassPointReliefProperty" $property {
  MassPointRelief : dem:MassPointRelief
}
class "dem:RasterRelief" <<FeatureType>> {
  # grid : gml:RectifiedGridCoverage
  ~ adeOfRasterRelief : dem:ADEOfRasterRelief [0..*]
}
class "dem:RasterReliefProperty" $property {
  RasterRelief : dem:RasterRelief
}
class "dem:ReliefFeature" <<FeatureType>> {
  # lod : core:IntegerBetween0and3
  ~ adeOfReliefFeature : dem:ADEOfReliefFeature [0..*]
}
class "dem:ReliefFeatureProperty" $property {
  ReliefFeature : dem:ReliefFeature
}
class "dem:TINRelief" <<FeatureType>> {
  # tin : gml:TriangulatedSurface
  ~ adeOfTINRelief : dem:ADEOfTINRelief [0..*]
}
class "dem:TINReliefProperty" $property {
  TINRelief : dem:TINRelief
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractSpaceBoundary"

"core:AbstractSpaceBoundary" <|-- "dem:AbstractReliefComponent"
"dem:AbstractReliefComponent" <|-- "dem:BreaklineRelief"
"dem:AbstractReliefComponent" <|-- "dem:MassPointRelief"
"dem:AbstractReliefComponent" <|-- "dem:RasterRelief"
"core:AbstractSpaceBoundary" <|-- "dem:ReliefFeature"
"dem:AbstractReliefComponent" <|-- "dem:TINRelief"

' Class relations (promoted from property wrappers)
"dem:ReliefFeature" o-- "1..*" "dem:AbstractReliefComponent" : reliefComponent

' ADE hook classes are removed from rendering by default;
' remove the next line to show them.
remove $adeOf

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' ADE hook attributes are marked as package members (~ ) and
' hidden from rendering by default; remove the next line to show them.
hide package members

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

@enduml
