"lise:Camera" o-- "0..1" "lise:GNSS" : gNSS
"lise:Camera" ..> "0..1" "lise:SensorSystem" : system
"lise:Equipment" o-- "1..*" "lise:SurveySensor" : surveySensor
"lise:GNSS" o-- "0..*" "lise:Camera" : camera
"lise:GNSS" o-- "0..1" "lise:Antenna" : antenna
"lise:GNSS" o-- "0..1" "lise:GNSS" : reference
"lise:LaserScanner" o-- "0..1" "lise:GenericAngle" : horizontalAngle
"lise:LaserScanner" o-- "0..1" "lise:GenericAngle" : verticalAngle
"lise:LaserScanner" o-- "0..1" "lise:EDM" : eDM
"lise:LaserScanner" o-- "0..*" "lise:Camera" : camera
"lise:Level" o-- "0..*" "lise:Camera" : camera
"lise:ObservationCorrections" ..> "1..*" "lise:Correction" : correction
"lise:SensorSystem" ..> "0..1" "lise:Distortion" : opticalDistortion
"lise:SurveyProcess" o-- "0..*" "lise:SurveySensor" : surveySensor
"lise:Tps" o-- "0..1" "lise:GenericAngle" : horizontalAngle
"lise:Tps" o-- "0..1" "lise:GenericAngle" : vericalAngle
"lise:Tps" o-- "0..1" "lise:EDM" : eDM
"lise:Tps" o-- "0..*" "lise:Camera" : camera

