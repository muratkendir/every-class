  CrossSectionArea : lifrcs:CrossSectionArea
}
class "lifrcs:CrossSectionComponent" <<ObjectType>> {
  # crossSectionComponentID : anonymous
  # material : xs:string [0..1]
  # isClosed : xs:boolean
