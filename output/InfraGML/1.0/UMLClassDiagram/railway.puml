@startuml
title
  Part5 - 1.0 - Railway - Only XSD based
  http://www.opengis.net/infragml/railway/1.0
end title

package lifrw {
class "lifrw:CantEvent" <<ObjectType>> {
  # eventAt : lr:DistanceExpression
  # appliedCant : gml:Measure
  # cantSide : li:Side
}
class "lifrw:CantEventProperty" $property {
  CantEvent : lifrw:CantEvent
}
class "lifrw:CantSpecification" <<ObjectType>> {
  # gauge : gml:Measure
  # name : xs:string
  # locatedAlong : lr:LinearElement
}
class "lifrw:CantSpecificationProperty" $property {
  CantSpecification : lifrw:CantSpecification
}
class "lifrw:Railway" <<FeatureType>> {
  # railwayID : anonymous
}
class "lifrw:RailwayProperty" $property {
  Railway : lifrw:Railway
}
class "lifrw:RailwayElement" <<FeatureType>> {
  # railwayElementID : anonymous
  # railwayElementType : gml:Reference
}
class "lifrw:RailwayElementProperty" $property {
  RailwayElement : lifrw:RailwayElement
}
class "lifrw:RailwayElementSet" <<ObjectType>> {
  # railwayElementSetID : anonymous
}
class "lifrw:RailwayElementSetProperty" $property {
  RailwayElementSet : lifrw:RailwayElementSet
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML"
class "lif:FacilityPart"
class "lif:PhysicalElement"

"gml:AbstractGML" <|-- "lifrw:CantEvent"
"gml:AbstractGML" <|-- "lifrw:CantSpecification"
"lif:FacilityPart" <|-- "lifrw:Railway"
"lif:PhysicalElement" <|-- "lifrw:RailwayElement"
"gml:AbstractGML" <|-- "lifrw:RailwayElementSet"

' Class relations (promoted from property wrappers)
"lifrw:CantSpecification" ..> "2..*" "lifrw:CantEvent" : cantEvent
"lifrw:Railway" ..> "0..*" "lifrw:RailwayElementSet" : railwayElementSet
"lifrw:Railway" o-- "0..*" "lifrw:RailwayElement" : element
"lifrw:Railway" ..> "0..*" "lifrw:CantSpecification" : cantSpecification
"lifrw:RailwayElementSet" o-- "1..*" "lifrw:RailwayElement" : element

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

@enduml
