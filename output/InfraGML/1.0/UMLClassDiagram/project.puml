package lip {
class "lip:Project" <<FeatureType>> {
  # projectID : anonymous
  # projectStatus : gml:Reference
  # statusDate : xs:date
}
class "lip:ProjectProperty" $property {
  Project : lip:Project
}
class "lip:ProjectPart" <<FeatureType>> {
  # projectPartID : anonymous
  # alternative : xs:string [0..1]
  # status : gml:Reference
  # statusDate : xs:date
  # facilityPart : lif:FacilityPart [1..*]
}
class "lip:ProjectPartProperty" $property {
  ProjectPart : lip:ProjectPart
}
}

' External types (unresolved namespaces)
class "li:Feature"

"li:Feature" <|-- "lip:Project"
"li:Feature" <|-- "lip:ProjectPart"

' Class relations (promoted from property wrappers)
"lip:Project" o-- "1..*" "lip:ProjectPart" : projectPart

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

