@startuml
title
  KML - 2.2.0 - Atom-author-link - Only XSD based
  http://www.w3.org/2005/Atom
end title

package atom {
class "atom:atomPersonConstruct" <<DataType>> {
  name : atom:name
  uri : atom:uri
  email : atom:email
}

' Simple types (from <simpleType> declarations)
class "atom:atomMedia" <<BasicType>>
class "atom:atomLanguageTag" <<BasicType>>
class "atom:atomEmailAddress" <<BasicType>>
}


@enduml
