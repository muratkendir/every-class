@startuml
title
  CityGML - 2.0 - Tunnel - Only XSD based
  http://www.opengis.net/citygml/tunnel/2.0
end title

class "AbstractTunnel" <<DataType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # yearOfConstruction : xs:gYear [0..1]
  # yearOfDemolition : xs:gYear [0..1]
  # lod1Solid : gml:Solid [0..1]
  # lod1MultiSurface : gml:MultiSurface [0..1]
  # lod1TerrainIntersection : gml:MultiCurve [0..1]
  # lod2Solid : gml:Solid [0..1]
  # lod2MultiSurface : gml:MultiSurface [0..1]
  # lod2MultiCurve : gml:MultiCurve [0..1]
  # lod2TerrainIntersection : gml:MultiCurve [0..1]
  # outerTunnelInstallation : TunnelInstallation [0..*]
  # interiorTunnelInstallation : IntTunnelInstallation [0..*]
  # boundedBy : BoundarySurface [0..*]
  # lod3Solid : gml:Solid [0..1]
  # lod3MultiSurface : gml:MultiSurface [0..1]
  # lod3MultiCurve : gml:MultiCurve [0..1]
  # lod3TerrainIntersection : gml:MultiCurve [0..1]
  # lod4Solid : gml:Solid [0..1]
  # lod4MultiSurface : gml:MultiSurface [0..1]
  # lod4MultiCurve : gml:MultiCurve [0..1]
  # lod4TerrainIntersection : gml:MultiCurve [0..1]
  # interiorHollowSpace : InteriorHollowSpace [0..*]
  # consistsOfTunnelPart : TunnelPart [0..*]
  #  : _GenericApplicationPropertyOfAbstractTunnel [0..*]
}
class "Tunnel" <<DataType>> {
  #  : _GenericApplicationPropertyOfTunnel [0..*]
}
class "TunnelPart" <<DataType>> {
  #  : _GenericApplicationPropertyOfTunnelPart [0..*]
}
class "TunnelPartProperty" $property {
  #  : TunnelPart
}
class "TunnelInstallation" <<DataType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # lod2Geometry : gml:Geometry [0..1]
  # lod3Geometry : gml:Geometry [0..1]
  # lod4Geometry : gml:Geometry [0..1]
  # lod2ImplicitRepresentation : core:ImplicitRepresentation [0..1]
  # lod3ImplicitRepresentation : core:ImplicitRepresentation [0..1]
  # lod4ImplicitRepresentation : core:ImplicitRepresentation [0..1]
  # boundedBy : BoundarySurface [0..*]
  #  : _GenericApplicationPropertyOfTunnelInstallation [0..*]
}
class "TunnelInstallationProperty" $property {
  #  : TunnelInstallation
}
