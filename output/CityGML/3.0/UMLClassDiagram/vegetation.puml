package veg {
abstract class "veg:ADEOfAbstractVegetationObject" as veg_ADEOfAbstractVegetationObject $adeOf
class "veg:ADEOfAbstractVegetationObjectProperty" as veg_ADEOfAbstractVegetationObjectProperty $property $adeOf {
  ADEOfAbstractVegetationObject : veg:ADEOfAbstractVegetationObject
}
abstract class "veg:ADEOfPlantCover" as veg_ADEOfPlantCover $adeOf
class "veg:ADEOfPlantCoverProperty" as veg_ADEOfPlantCoverProperty $property $adeOf {
  ADEOfPlantCover : veg:ADEOfPlantCover
}
abstract class "veg:ADEOfSolitaryVegetationObject" as veg_ADEOfSolitaryVegetationObject $adeOf
class "veg:ADEOfSolitaryVegetationObjectProperty" as veg_ADEOfSolitaryVegetationObjectProperty $property $adeOf {
  ADEOfSolitaryVegetationObject : veg:ADEOfSolitaryVegetationObject
}
abstract class "veg:AbstractVegetationObject" as veg_AbstractVegetationObject <<FeatureType>> {
  ~ adeOfAbstractVegetationObject : veg:ADEOfAbstractVegetationObject [0..*]
}
class "veg:AbstractVegetationObjectProperty" as veg_AbstractVegetationObjectProperty $property {
  AbstractVegetationObject : veg:AbstractVegetationObject
}
class "veg:PlantCover" as veg_PlantCover <<FeatureType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # averageHeight : gml:Length [0..1]
  # minHeight : gml:Length [0..1]
  # maxHeight : gml:Length [0..1]
  ~ adeOfPlantCover : veg:ADEOfPlantCover [0..*]
}
class "veg:PlantCoverProperty" as veg_PlantCoverProperty $property {
  PlantCover : veg:PlantCover
}
class "veg:SolitaryVegetationObject" as veg_SolitaryVegetationObject <<FeatureType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # species : gml:Code [0..1]
  # height : gml:Length [0..1]
  # trunkDiameter : gml:Length [0..1]
  # crownDiameter : gml:Length [0..1]
  # rootBallDiameter : gml:Length [0..1]
  # maxRootBallDepth : gml:Length [0..1]
  ~ adeOfSolitaryVegetationObject : veg:ADEOfSolitaryVegetationObject [0..*]
}
class "veg:SolitaryVegetationObjectProperty" as veg_SolitaryVegetationObjectProperty $property {
  SolitaryVegetationObject : veg:SolitaryVegetationObject
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractOccupiedSpace" as core_AbstractOccupiedSpace

"core_AbstractOccupiedSpace" <|-- "veg_AbstractVegetationObject"
"veg_AbstractVegetationObject" <|-- "veg_PlantCover"
"veg_AbstractVegetationObject" <|-- "veg_SolitaryVegetationObject"

