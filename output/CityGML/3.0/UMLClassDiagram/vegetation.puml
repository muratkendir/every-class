@startuml
title
  CityGML - 3.0 - Vegetation - Only XSD based
  http://www.opengis.net/citygml/vegetation/3.0
end title

package veg {
abstract class "veg:ADEOfAbstractVegetationObject" $adeOf
class "veg:ADEOfAbstractVegetationObjectProperty" $property $adeOf {
  ADEOfAbstractVegetationObject : veg:ADEOfAbstractVegetationObject
}
abstract class "veg:ADEOfPlantCover" $adeOf
class "veg:ADEOfPlantCoverProperty" $property $adeOf {
  ADEOfPlantCover : veg:ADEOfPlantCover
}
abstract class "veg:ADEOfSolitaryVegetationObject" $adeOf
class "veg:ADEOfSolitaryVegetationObjectProperty" $property $adeOf {
  ADEOfSolitaryVegetationObject : veg:ADEOfSolitaryVegetationObject
}
abstract class "veg:AbstractVegetationObject" <<FeatureType>> {
  ~ adeOfAbstractVegetationObject : veg:ADEOfAbstractVegetationObject [0..*]
}
class "veg:AbstractVegetationObjectProperty" $property {
  AbstractVegetationObject : veg:AbstractVegetationObject
}
class "veg:PlantCover" <<FeatureType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # averageHeight : gml:Length [0..1]
  # minHeight : gml:Length [0..1]
  # maxHeight : gml:Length [0..1]
  ~ adeOfPlantCover : veg:ADEOfPlantCover [0..*]
}
class "veg:PlantCoverProperty" $property {
  PlantCover : veg:PlantCover
}
class "veg:SolitaryVegetationObject" <<FeatureType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  # species : gml:Code [0..1]
  # height : gml:Length [0..1]
  # trunkDiameter : gml:Length [0..1]
  # crownDiameter : gml:Length [0..1]
  # rootBallDiameter : gml:Length [0..1]
  # maxRootBallDepth : gml:Length [0..1]
  ~ adeOfSolitaryVegetationObject : veg:ADEOfSolitaryVegetationObject [0..*]
}
class "veg:SolitaryVegetationObjectProperty" $property {
  SolitaryVegetationObject : veg:SolitaryVegetationObject
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractOccupiedSpace"

"core:AbstractOccupiedSpace" <|-- "veg:AbstractVegetationObject"
"veg:AbstractVegetationObject" <|-- "veg:PlantCover"
"veg:AbstractVegetationObject" <|-- "veg:SolitaryVegetationObject"

' ADE hook classes are removed from rendering by default;
' remove the next line to show them.
remove $adeOf

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' ADE hook attributes are marked as package members (~ ) and
' hidden from rendering by default; remove the next line to show them.
hide package members

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

