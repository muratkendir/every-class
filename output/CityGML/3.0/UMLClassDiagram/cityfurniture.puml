@startuml
title
  CityGML - 3.0 - Cityfurniture - Only XSD based
  http://www.opengis.net/citygml/cityfurniture/3.0
end title

package frn {
abstract class "frn:ADEOfCityFurniture" $adeOf
class "frn:ADEOfCityFurnitureProperty" $property $adeOf {
  ADEOfCityFurniture : frn:ADEOfCityFurniture
}
class "frn:CityFurniture" <<FeatureType>> {
  # class : gml:Code [0..1]
  # function : gml:Code [0..*]
  # usage : gml:Code [0..*]
  ~ adeOfCityFurniture : frn:ADEOfCityFurniture [0..*]
}
class "frn:CityFurnitureProperty" $property {
  CityFurniture : frn:CityFurniture
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractOccupiedSpace"

"core:AbstractOccupiedSpace" <|-- "frn:CityFurniture"

' ADE hook classes are removed from rendering by default;
' remove the next line to show them.
remove $adeOf

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' ADE hook attributes are marked as package members (~ ) and
' hidden from rendering by default; remove the next line to show them.
hide package members

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

@enduml
