@startuml
title
  CityGML - 3.0 - Versioning - Only XSD based
  http://www.opengis.net/citygml/versioning/3.0
end title

package vers {
abstract class "vers:ADEOfVersion" as vers_ADEOfVersion $adeOf
class "vers:ADEOfVersionProperty" as vers_ADEOfVersionProperty $property $adeOf {
  ADEOfVersion : vers:ADEOfVersion
}
abstract class "vers:ADEOfVersionTransition" as vers_ADEOfVersionTransition $adeOf
class "vers:ADEOfVersionTransitionProperty" as vers_ADEOfVersionTransitionProperty $property $adeOf {
  ADEOfVersionTransition : vers:ADEOfVersionTransition
}
class "vers:Transaction" as vers_Transaction <<DataType>> {
  type : vers:TransactionTypeValue
}
class "vers:TransactionProperty" as vers_TransactionProperty $property {
  Transaction : vers:Transaction
}
class "vers:Version" as vers_Version <<FeatureType>> {
  # tag : xs:string [0..*]
  ~ adeOfVersion : vers:ADEOfVersion [0..*]
}
class "vers:VersionProperty" as vers_VersionProperty $property {
  Version : vers:Version
}
class "vers:VersionTransition" as vers_VersionTransition <<FeatureType>> {
  # reason : xs:string [0..1]
  # clonePredecessor : xs:boolean
  type : vers:TransitionTypeValue [0..1]
  ~ adeOfVersionTransition : vers:ADEOfVersionTransition [0..*]
  - transaction : vers:Transaction [0..*]
}
class "vers:VersionTransitionProperty" as vers_VersionTransitionProperty $property {
  VersionTransition : vers:VersionTransition
}

' Simple types (from <simpleType> declarations)
class "vers:TransactionTypeValue" as vers_TransactionTypeValue <<Enumeration>> {
  insert
  delete
  replace
}
class "vers:TransitionTypeValue" as vers_TransitionTypeValue <<Enumeration>> {
  planned
  realized
  historicalSuccession
  fork
  merge
}
}

' External types (unresolved namespaces)
abstract class "core:AbstractFeatureWithLifespan" as core_AbstractFeatureWithLifespan
abstract class "core:AbstractVersion" as core_AbstractVersion
abstract class "core:AbstractVersionTransition" as core_AbstractVersionTransition

"core_AbstractVersion" <|-- "vers_Version"
"core_AbstractVersionTransition" <|-- "vers_VersionTransition"

' Class relations (promoted from property wrappers)
"vers_Transaction" ..> "0..1" "core_AbstractFeatureWithLifespan" : oldFeature
"vers_Transaction" ..> "0..1" "core_AbstractFeatureWithLifespan" : newFeature
"vers_Version" o-- "0..*" "core_AbstractFeatureWithLifespan" : versionMember
"vers_VersionTransition" ..> "0..1" "vers_Version" : from
"vers_VersionTransition" ..> "0..1" "vers_Version" : to

' ADE hook classes are removed from rendering by default;
' remove the next line to show them.
remove $adeOf

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' ADE hook attributes are marked as package members (~ ) and
' hidden from rendering by default; remove the next line to show them.
hide package members

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

footer Generated on 2026-10-14 14:37:57
@enduml
