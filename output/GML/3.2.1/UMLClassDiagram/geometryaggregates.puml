package gml {
abstract class "gml:AbstractGeometricAggregate" as gml_AbstractGeometricAggregate <<ObjectType>>
class "gml:MultiGeometry" as gml_MultiGeometry <<ObjectType>> {
  geometryMember : gml:geometryMember [0..*]
  geometryMembers : gml:geometryMembers [0..1]
}
class "gml:MultiGeometryProperty" as gml_MultiGeometryProperty $property {
  AbstractGeometricAggregate : gml:AbstractGeometricAggregate
}
class "gml:MultiPoint" as gml_MultiPoint <<ObjectType>> {
  pointMember : gml:pointMember [0..*]
  pointMembers : gml:pointMembers [0..1]
}
class "gml:MultiPointProperty" as gml_MultiPointProperty $property {
  MultiPoint : gml:MultiPoint
}
class "gml:MultiCurve" as gml_MultiCurve <<ObjectType>> {
  curveMember : gml:curveMember [0..*]
  curveMembers : gml:curveMembers [0..1]
}
class "gml:MultiCurveProperty" as gml_MultiCurveProperty $property {
  MultiCurve : gml:MultiCurve
}
class "gml:MultiSurface" as gml_MultiSurface <<ObjectType>> {
  surfaceMember : gml:surfaceMember [0..*]
  surfaceMembers : gml:surfaceMembers [0..1]
}
class "gml:MultiSurfaceProperty" as gml_MultiSurfaceProperty $property {
  MultiSurface : gml:MultiSurface
}
class "gml:MultiSolid" as gml_MultiSolid <<ObjectType>> {
  solidMember : gml:solidMember [0..*]
  solidMembers : gml:solidMembers [0..1]
}
class "gml:MultiSolidProperty" as gml_MultiSolidProperty $property {
  MultiSolid : gml:MultiSolid
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGeometry" as gml_AbstractGeometry

"gml_AbstractGeometry" <|-- "gml_AbstractGeometricAggregate"
"gml_AbstractGeometricAggregate" <|-- "gml_MultiGeometry"
"gml_AbstractGeometricAggregate" <|-- "gml_MultiPoint"
"gml_AbstractGeometricAggregate" <|-- "gml_MultiCurve"
"gml_AbstractGeometricAggregate" <|-- "gml_MultiSurface"
"gml_AbstractGeometricAggregate" <|-- "gml_MultiSolid"

