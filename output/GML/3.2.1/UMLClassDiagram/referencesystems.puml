@startuml
title
  GML - 3.2.1 - Referencesystems - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:IdentifiedObject" as gml_IdentifiedObject <<ObjectType>>
abstract class "gml:AbstractCRS" as gml_AbstractCRS <<ObjectType>> {
  domainOfValidity : gml:domainOfValidity [0..*]
  scope : gml:scope [1..*]
}
class "gml:CRSProperty" as gml_CRSProperty $property {
  AbstractCRS : gml:AbstractCRS
}
}

' External types (unresolved namespaces)
class "gml:Definition" as gml_Definition

"gml_Definition" <|-- "gml_IdentifiedObject"
"gml_IdentifiedObject" <|-- "gml_AbstractCRS"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
