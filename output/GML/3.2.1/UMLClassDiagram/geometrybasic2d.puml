@startuml
title
  GML - 3.2.1 - Geometrybasic2d - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractSurface" as gml_AbstractSurface <<ObjectType>>
class "gml:SurfaceProperty" as gml_SurfaceProperty $property {
  AbstractSurface : gml:AbstractSurface
}
class "gml:SurfaceArrayProperty" as gml_SurfaceArrayProperty $property {
  AbstractSurface : gml:AbstractSurface
}
class "gml:Polygon" as gml_Polygon <<ObjectType>> {
  exterior : gml:exterior [0..1]
  interior : gml:interior [0..*]
}
abstract class "gml:AbstractRing" as gml_AbstractRing <<ObjectType>>
class "gml:AbstractRingProperty" as gml_AbstractRingProperty $property {
  AbstractRing : gml:AbstractRing
}
class "gml:LinearRing" as gml_LinearRing <<ObjectType>> {
  pos : gml:pos
  pointProperty : gml:point
  pointRep : gml:pointRep
  posList : gml:posList
  coordinates : gml:coordinates
}
class "gml:LinearRingProperty" as gml_LinearRingProperty $property {
  LinearRing : gml:LinearRing
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractCurve" as gml_AbstractCurve
abstract class "gml:AbstractGeometricPrimitive" as gml_AbstractGeometricPrimitive

"gml_AbstractGeometricPrimitive" <|-- "gml_AbstractSurface"
"gml_AbstractSurface" <|-- "gml_Polygon"
"gml_AbstractCurve" <|-- "gml_AbstractRing"
"gml_AbstractRing" <|-- "gml_LinearRing"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
