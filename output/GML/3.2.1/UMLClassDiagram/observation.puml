@startuml
title
  GML - 3.2.1 - Observation - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:Observation" as gml_Observation <<FeatureType>> {
  validTime : gml:validTime
  using : gml:using [0..1]
  target : gml:target [0..1]
  resultOf : gml:resultOf
}
class "gml:ProcedureProperty" as gml_ProcedureProperty $property {
  AbstractFeature : gml:AbstractFeature
}
class "gml:TargetProperty" as gml_TargetProperty $property {
  AbstractFeature : gml:AbstractFeature
  AbstractGeometry : gml:AbstractGeometry
}
class "gml:Result" as gml_Result <<DataType>>
class "gml:DirectedObservation" as gml_DirectedObservation <<FeatureType>> {
  direction : gml:direction
}
class "gml:DirectedObservationAtDistance" as gml_DirectedObservationAtDistance <<FeatureType>> {
  distance : gml:Measure
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractFeature" as gml_AbstractFeature

"gml_AbstractFeature" <|-- "gml_Observation"
"gml_Observation" <|-- "gml_DirectedObservation"
"gml_DirectedObservation" <|-- "gml_DirectedObservationAtDistance"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
