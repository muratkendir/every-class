package gml {
abstract class "gml:AbstractTimeObject" as gml_AbstractTimeObject <<ObjectType>>
abstract class "gml:AbstractTimePrimitive" as gml_AbstractTimePrimitive <<ObjectType>> {
  relatedTime : gml:RelatedTime [0..*]
}
class "gml:TimePrimitiveProperty" as gml_TimePrimitiveProperty $property {
  AbstractTimePrimitive : gml:AbstractTimePrimitive
}
class "gml:RelatedTime" as gml_RelatedTime <<ObjectType>>
abstract class "gml:AbstractTimeComplex" as gml_AbstractTimeComplex <<ObjectType>>
abstract class "gml:AbstractTimeGeometricPrimitive" as gml_AbstractTimeGeometricPrimitive <<ObjectType>>
class "gml:TimeInstant" as gml_TimeInstant <<ObjectType>> {
  timePosition : gml:timePosition
}
class "gml:TimeInstantProperty" as gml_TimeInstantProperty $property {
  TimeInstant : gml:TimeInstant
}
class "gml:TimePeriod" as gml_TimePeriod <<ObjectType>> {
  beginPosition : gml:TimePosition
  endPosition : gml:TimePosition
}
class "gml:TimePeriodProperty" as gml_TimePeriodProperty $property {
  TimePeriod : gml:TimePeriod
}
class "gml:TimePosition" as gml_TimePosition <<DataType>>
class "gml:TimeIntervalLength" as gml_TimeIntervalLength <<DataType>>

' Simple types (from <simpleType> declarations)
class "gml:TimeIndeterminateValue" as gml_TimeIndeterminateValue <<Enumeration>> {
  after
  before
  now
  unknown
}
class "gml:TimePositionUnion" as gml_TimePositionUnion <<Union>>
class "gml:CalDate" as gml_CalDate <<Union>>
class "gml:TimeUnit" as gml_TimeUnit <<Union>> {
  year
  month
  day
  hour
  minute
  second
}

' Model groups (from <group> declarations)
class "gml:timeLength" as gml_timeLength <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML" as gml_AbstractGML

"gml_AbstractGML" <|-- "gml_AbstractTimeObject"
