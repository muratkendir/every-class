@startuml
title
  GML - 3.2.1 - Temporaltopology - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractTimeTopologyPrimitive" <<ObjectType>> {
  complex : gml:Reference [0..1]
}
class "gml:TimeTopologyPrimitiveProperty" $property {
  AbstractTimeTopologyPrimitive : gml:AbstractTimeTopologyPrimitive
}
abstract class "gml:TimeTopologyComplex" <<ObjectType>>
class "gml:TimeTopologyComplexProperty" $property {
  TimeTopologyComplex : gml:TimeTopologyComplex
}
class "gml:TimeNode" <<ObjectType>> {
  position : gml:TimeInstant [0..1]
}
class "gml:TimeNodeProperty" $property {
  TimeNode : gml:TimeNode
}
class "gml:TimeEdge" <<ObjectType>> {
  extent : gml:TimePeriod [0..1]
}
class "gml:TimeEdgeProperty" $property {
  TimeEdge : gml:TimeEdge
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractTimeComplex"
abstract class "gml:AbstractTimePrimitive"

"gml:AbstractTimePrimitive" <|-- "gml:AbstractTimeTopologyPrimitive"
"gml:AbstractTimeComplex" <|-- "gml:TimeTopologyComplex"
"gml:AbstractTimeTopologyPrimitive" <|-- "gml:TimeNode"
"gml:AbstractTimeTopologyPrimitive" <|-- "gml:TimeEdge"

' Class relations (promoted from property wrappers)
"gml:TimeTopologyComplex" ..> "1..*" "gml:AbstractTimeTopologyPrimitive" : primitive
"gml:TimeNode" ..> "0..*" "gml:TimeEdge" : previousEdge
"gml:TimeNode" ..> "0..*" "gml:TimeEdge" : nextEdge
"gml:TimeEdge" ..> "1" "gml:TimeNode" : start
"gml:TimeEdge" ..> "1" "gml:TimeNode" : end

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-08-03 13:11:00
@enduml
