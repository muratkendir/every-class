@startuml
title
  GML - 3.2.1 - Grids - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
class "gml:Grid" <<ObjectType>> {
  limits : gml:GridLimits
  axisLabels : gml:NCNameList
  # axisName : xs:string [1..*]
}
class "gml:GridLimits" <<DataType>> {
  GridEnvelope : gml:GridEnvelope
}
class "gml:GridEnvelope" <<DataType>> {
  low : gml:integerList
  high : gml:integerList
}
class "gml:RectifiedGrid" <<ObjectType>> {
  origin : gml:Point
  offsetVector : gml:Vector [1..*]
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGeometry"

"gml:AbstractGeometry" <|-- "gml:Grid"
"gml:Grid" <|-- "gml:RectifiedGrid"

