@startuml
title
  GML - 3.2.1 - Coverage - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractCoverage" as gml_AbstractCoverage <<FeatureType>> {
  domainSet : gml:domainSet
  rangeSet : gml:rangeSet
}
class "gml:DiscreteCoverage" as gml_DiscreteCoverage <<FeatureType>> {
  coverageFunction : gml:coverageFunction [0..1]
}
abstract class "gml:AbstractContinuousCoverage" as gml_AbstractContinuousCoverage <<FeatureType>> {
  coverageFunction : gml:coverageFunction [0..1]
}
class "gml:DomainSet" as gml_DomainSet <<DataType>> {
  AbstractGeometry : gml:AbstractGeometry
  AbstractTimeObject : gml:AbstractTimeObject
}
class "gml:RangeSet" as gml_RangeSet <<DataType>> {
  ValueArray : gml:ValueArray [1..*]
  AbstractScalarValueList : gml:AbstractScalarValueList [1..*]
  DataBlock : gml:DataBlock
  File : gml:File
}
class "gml:DataBlock" as gml_DataBlock <<DataType>> {
  rangeParameters : gml:rangeParameters
  tupleList : gml:tupleList
  doubleOrNilReasonTupleList : gml:doubleOrNilReasonTupleList
}
class "gml:File" as gml_File <<DataType>> {
  rangeParameters : gml:rangeParameters
  # fileName : xs:anyURI
  # fileReference : xs:anyURI
  fileStructure : gml:Code
  # mimeType : xs:anyURI [0..1]
  # compression : xs:anyURI [0..1]
}
class "gml:CoverageFunction" as gml_CoverageFunction <<DataType>> {
  MappingRule : gml:MappingRule
  CoverageMappingRule : gml:CoverageMappingRule
  GridFunction : gml:GridFunction
}
class "gml:MappingRule" as gml_MappingRule <<DataType>> {
  # ruleDefinition : xs:string
  ruleReference : gml:Reference
}
class "gml:GridFunction" as gml_GridFunction <<DataType>> {
  sequenceRule : gml:SequenceRule [0..1]
  startPoint : gml:integerList [0..1]
}
class "gml:SequenceRule" as gml_SequenceRule <<DataType>>

' Simple types (from <simpleType> declarations)
class "gml:SequenceRuleEnumeration" as gml_SequenceRuleEnumeration <<Enumeration>> {
  Linear
  Boustrophedonic
  Cantor-diagonal
  Spiral
  Morton
  Hilbert
}
class "gml:AxisDirectionList" as gml_AxisDirectionList <<BasicType>>
class "gml:AxisDirection" as gml_AxisDirection <<BasicType>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractFeature" as gml_AbstractFeature

"gml_AbstractFeature" <|-- "gml_AbstractCoverage"
"gml_AbstractCoverage" <|-- "gml_DiscreteCoverage"
"gml_AbstractCoverage" <|-- "gml_AbstractContinuousCoverage"

