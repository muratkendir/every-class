@startuml
title
  GML - 3.2.1 - Topology - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractTopology" <<ObjectType>>
abstract class "gml:AbstractTopoPrimitive" <<ObjectType>>
class "gml:NodeOrEdgeProperty" $property {
  Node : gml:Node
  Edge : gml:Edge
}
class "gml:NodeProperty" $property {
  Node : gml:Node
}
class "gml:FaceOrTopoSolidProperty" $property {
  Face : gml:Face
  TopoSolid : gml:TopoSolid
}
class "gml:TopoSolidProperty" $property {
  TopoSolid : gml:TopoSolid
}
class "gml:Node" <<ObjectType>> {
  directedEdge : gml:directedEdge [0..*]
  pointProperty : gml:point [0..1]
}
class "gml:DirectedNodeProperty" $property {
  Node : gml:Node
}
class "gml:Edge" <<ObjectType>> {
  directedNode : gml:directedNode [2]
  directedFace : gml:directedFace [0..*]
  curveProperty : gml:curve [0..1]
}
class "gml:DirectedEdgeProperty" $property {
  Edge : gml:Edge
}
class "gml:Face" <<ObjectType>> {
  directedEdge : gml:directedEdge [1..*]
  directedTopoSolid : gml:directedTopoSolid [0..2]
  surfaceProperty : gml:surface [0..1]
}
class "gml:DirectedFaceProperty" $property {
  Face : gml:Face
}
class "gml:TopoSolid" <<ObjectType>> {
  directedFace : gml:directedFace [1..*]
  solidProperty : gml:solid [0..1]
}
class "gml:DirectedTopoSolidProperty" $property {
  TopoSolid : gml:TopoSolid
}
class "gml:TopoPoint" <<ObjectType>> {
  directedNode : gml:directedNode
}
class "gml:TopoPointProperty" $property {
  TopoPoint : gml:TopoPoint
}
class "gml:TopoCurve" <<ObjectType>> {
  directedEdge : gml:directedEdge [1..*]
}
class "gml:TopoCurveProperty" $property {
  TopoCurve : gml:TopoCurve
}
class "gml:TopoSurface" <<ObjectType>> {
  directedFace : gml:directedFace [1..*]
}
class "gml:TopoSurfaceProperty" $property {
  TopoSurface : gml:TopoSurface
}
class "gml:TopoVolume" <<ObjectType>> {
  directedTopoSolid : gml:directedTopoSolid [1..*]
}
class "gml:TopoVolumeProperty" $property {
  TopoVolume : gml:TopoVolume
}
class "gml:TopoComplex" <<ObjectType>> {
  maximalComplex : gml:maximalComplex
  superComplex : gml:superComplex [0..*]
  subComplex : gml:subComplex [0..*]
  topoPrimitiveMember : gml:topoPrimitiveMember [0..*]
  topoPrimitiveMembers : gml:topoPrimitiveMembers [0..1]
}
class "gml:TopoPrimitiveMember" <<DataType>> {
  AbstractTopoPrimitive : gml:AbstractTopoPrimitive
}
class "gml:TopoPrimitiveArrayAssociation" <<DataType>> {
  AbstractTopoPrimitive : gml:AbstractTopoPrimitive
}
class "gml:TopoComplexProperty" $property {
  TopoComplex : gml:TopoComplex
}
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML"

"gml:AbstractGML" <|-- "gml:AbstractTopology"
"gml:AbstractTopology" <|-- "gml:AbstractTopoPrimitive"
"gml:AbstractTopoPrimitive" <|-- "gml:Node"
"gml:AbstractTopoPrimitive" <|-- "gml:Edge"
"gml:AbstractTopoPrimitive" <|-- "gml:Face"
"gml:AbstractTopoPrimitive" <|-- "gml:TopoSolid"
"gml:AbstractTopology" <|-- "gml:TopoPoint"
"gml:AbstractTopology" <|-- "gml:TopoCurve"
"gml:AbstractTopology" <|-- "gml:TopoSurface"
"gml:AbstractTopology" <|-- "gml:TopoVolume"
"gml:AbstractTopology" <|-- "gml:TopoComplex"

' Class relations (promoted from property wrappers)
"gml:Node" ..> "0..1" "gml:Face" : container
"gml:Edge" ..> "0..1" "gml:TopoSolid" : container
"gml:Face" ..> "0..*" "gml:Node" : isolated
"gml:TopoSolid" ..> "0..*" "gml:Node" : isolated

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-08-03 13:11:00
@enduml
