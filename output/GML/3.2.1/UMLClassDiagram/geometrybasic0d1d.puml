@startuml
title
  GML - 3.2.1 - Geometrybasic0d1d - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractGeometry" <<ObjectType>>
class "gml:GeometryProperty" $property {
  AbstractGeometry : gml:AbstractGeometry
}
class "gml:GeometryArrayProperty" $property {
  AbstractGeometry : gml:AbstractGeometry
}
class "gml:DirectPosition" <<DataType>>
class "gml:DirectPositionList" <<DataType>>
class "gml:Vector" <<DataType>>
class "gml:Envelope" <<DataType>> {
  lowerCorner : gml:DirectPosition
  upperCorner : gml:DirectPosition
  pos : gml:pos [2]
  coordinates : gml:coordinates
}
abstract class "gml:AbstractGeometricPrimitive" <<ObjectType>>
class "gml:GeometricPrimitiveProperty" $property {
  AbstractGeometricPrimitive : gml:AbstractGeometricPrimitive
}
class "gml:Point" <<ObjectType>> {
  pos : gml:pos
  coordinates : gml:coordinates
}
class "gml:PointProperty" $property {
  Point : gml:Point
}
class "gml:PointArrayProperty" $property {
  Point : gml:Point
}
abstract class "gml:AbstractCurve" <<ObjectType>>
class "gml:CurveProperty" $property {
  AbstractCurve : gml:AbstractCurve
}
class "gml:CurveArrayProperty" $property {
  AbstractCurve : gml:AbstractCurve
}
class "gml:LineString" <<ObjectType>> {
  pos : gml:pos
  pointProperty : gml:point
  pointRep : gml:pointRep
  posList : gml:posList
  coordinates : gml:coordinates
}

' Model groups (from <group> declarations)
class "gml:geometricPosition" <<Union>>
class "gml:geometricPositionList" <<Union>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML"

"gml:AbstractGML" <|-- "gml:AbstractGeometry"
"gml:AbstractGeometry" <|-- "gml:AbstractGeometricPrimitive"
"gml:AbstractGeometricPrimitive" <|-- "gml:Point"
"gml:AbstractGeometricPrimitive" <|-- "gml:AbstractCurve"
"gml:AbstractCurve" <|-- "gml:LineString"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-08-03 13:11:00
@enduml
