@startuml
title
  GML - 3.2.1 - Feature - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractFeature" as gml_AbstractFeature <<ObjectType>> {
  boundedBy : gml:boundedBy [0..1]
  location : gml:location [0..1]
}
class "gml:FeatureProperty" as gml_FeatureProperty $property {
  AbstractFeature : gml:AbstractFeature
}
class "gml:BoundingShape" as gml_BoundingShape <<DataType>> {
  Envelope : gml:Envelope
  Null : gml:Null
}
class "gml:EnvelopeWithTimePeriod" as gml_EnvelopeWithTimePeriod <<ObjectType>> {
  beginPosition : gml:TimePosition
  endPosition : gml:TimePosition
}
abstract class "gml:AbstractFeatureMember" as gml_AbstractFeatureMember <<DataType>>
}

' External types (unresolved namespaces)
abstract class "gml:AbstractGML" as gml_AbstractGML
class "gml:Envelope" as gml_Envelope

"gml_AbstractGML" <|-- "gml_AbstractFeature"
"gml_Envelope" <|-- "gml_EnvelopeWithTimePeriod"

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
