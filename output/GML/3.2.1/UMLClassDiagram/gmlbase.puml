@startuml
title
  GML - 3.2.1 - Gmlbase - Only XSD based
  http://www.opengis.net/gml/3.2
end title

package gml {
abstract class "gml:AbstractGML" as gml_AbstractGML <<DataType>>
class "gml:AssociationRole" as gml_AssociationRole <<DataType>>
class "gml:Reference" as gml_Reference <<DataType>>
class "gml:InlineProperty" as gml_InlineProperty $property
abstract class "gml:AbstractMember" as gml_AbstractMember <<DataType>>
abstract class "gml:AbstractMetadataProperty" as gml_AbstractMetadataProperty $property

' Simple types (from <simpleType> declarations)
class "gml:Aggregation" as gml_Aggregation <<Enumeration>> {
  set
  bag
  sequence
  array
  record
  table
}

' Model groups (from <group> declarations)
class "gml:StandardObjectProperties" as gml_StandardObjectProperties <<Union>>
}


' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

footer Generated on 2026-10-21 03:55:54
@enduml
