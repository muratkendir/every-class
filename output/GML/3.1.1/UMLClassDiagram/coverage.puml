package gml {
abstract class "gml:AbstractCoverage" <<FeatureType>> {
  domainSet : gml:domainSet
  rangeSet : gml:rangeSet
}
abstract class "gml:AbstractContinuousCoverage" <<FeatureType>> {
  coverageFunction : gml:coverageFunction [0..1]
}
abstract class "gml:AbstractDiscreteCoverage" <<FeatureType>> {
  coverageFunction : gml:coverageFunction [0..1]
}
class "gml:DomainSet" <<DataType>> {
