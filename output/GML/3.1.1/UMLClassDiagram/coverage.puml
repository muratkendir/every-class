}
class "gml:IndexMap" <<ObjectType>> {
  lookUpTable : gml:integerList
}
class "gml:SequenceRule" <<DataType>>
class "gml:MultiPointCoverage" <<FeatureType>> {
  boundedBy : gml:boundedBy [0..1]
