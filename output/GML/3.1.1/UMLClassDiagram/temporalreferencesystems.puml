@startuml
title
  Base - 3.1.1 - Temporalreferencesystems - Only XSD based
  http://www.opengis.net/gml
end title

package gml {
abstract class "gml:AbstractTimeReferenceSystem" <<ObjectType>> {
  # domainOfValidity : xs:string [0..1]
}
class "gml:TimeCoordinateSystem" <<ObjectType>> {
  originPosition : gml:TimePosition
  origin : gml:TimeInstant
  interval : gml:TimeIntervalLength
}
class "gml:TimeOrdinalReferenceSystem" <<ObjectType>>
class "gml:TimeOrdinalEra" <<ObjectType>> {
  relatedTime : gml:RelatedTime [0..*]
  start : gml:TimeNode
  end : gml:TimeNode
  extent : gml:TimePeriod [0..1]
  group : gml:Reference [0..1]
}
class "gml:TimeOrdinalEraProperty" $property {
  TimeOrdinalEra : gml:TimeOrdinalEra
}
class "gml:TimeCalendar" <<ObjectType>>
class "gml:TimeCalendarProperty" $property {
  TimeCalendar : gml:TimeCalendar
}
class "gml:TimeCalendarEra" <<ObjectType>> {
  referenceEvent : gml:StringOrRef
  # referenceDate : xs:date [0..1]
  # julianReference : xs:decimal
  epochOfUse : gml:TimePeriod
}
class "gml:TimeCalendarEraProperty" $property {
  TimeCalendarEra : gml:TimeCalendarEra
}
class "gml:TimeClock" <<ObjectType>> {
  referenceEvent : gml:StringOrRef
  # referenceTime : xs:time
  # utcReference : xs:time
}
class "gml:TimeClockProperty" $property {
  TimeClock : gml:TimeClock
}
}

' External types (unresolved namespaces)
class "gml:Definition"

"gml:Definition" <|-- "gml:AbstractTimeReferenceSystem"
"gml:AbstractTimeReferenceSystem" <|-- "gml:TimeCoordinateSystem"
"gml:AbstractTimeReferenceSystem" <|-- "gml:TimeOrdinalReferenceSystem"
"gml:Definition" <|-- "gml:TimeOrdinalEra"
"gml:AbstractTimeReferenceSystem" <|-- "gml:TimeCalendar"
"gml:Definition" <|-- "gml:TimeCalendarEra"
"gml:AbstractTimeReferenceSystem" <|-- "gml:TimeClock"

' Class relations (promoted from property wrappers)
"gml:TimeOrdinalReferenceSystem" ..> "1..*" "gml:TimeOrdinalEra" : component
"gml:TimeOrdinalEra" ..> "0..*" "gml:TimeOrdinalEra" : member
"gml:TimeCalendar" ..> "1..*" "gml:TimeCalendarEra" : referenceFrame
"gml:TimeClock" ..> "0..*" "gml:TimeCalendar" : dateBasis

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

