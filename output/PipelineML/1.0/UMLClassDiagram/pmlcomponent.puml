"pml:CoterminousComponent" <|-- "pml:Tee"
"pml:CoterminousComponent" <|-- "pml:Valve"
"pml:ConnectorComponent" <|-- "pml:Virtualconnector"

' Class relations (promoted from property wrappers)
"pml:Assembly" o-- "0..*" "pml:Component" : component
"pml:Collection" "1" *-- "0..*" "pml:CollectionMember" : collectionMember
"pml:PMLDataset" o-- "0..*" "pml:Component" : component
"pml:PMLDataset" o-- "0..*" "pml:Collection" : collection
"pml:PMLDataset" o-- "0..*" "pml:Assembly" : assembly
"pml:PMLDataset" "1" *-- "0..*" "pml:Pipeline" : pipeline
"pml:Pipeline" "1" *-- "1..*" "pml:Assembly" : assembly

' Property pseudo-classes are removed from rendering by default;
' remove the next line to show them.
remove $property

' Attributes with value types from other namespaces are marked as
' protected members (# ) and shown by default; uncomment the next
' line to hide them.
' hide protected members

@enduml
