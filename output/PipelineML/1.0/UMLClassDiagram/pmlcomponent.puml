"gml:AbstractGML" <|-- "pml:DataType1"
"pml:CoterminousComponent" <|-- "pml:Elbow"
"pml:CoterminousComponent" <|-- "pml:Flange"
"gml:AbstractGML" <|-- "pml:ISO-19103-CoreDataTypes"
"pml:CoterminousComponent" <|-- "pml:Launcherreceiver"
"pml:CoterminousComponent" <|-- "pml:Linepipe"
"pml:CoterminousComponent" <|-- "pml:Meter"
"gml:AbstractGML" <|-- "pml:PMLDataset"
"pml:ConnectorComponent" <|-- "pml:Pipeconnector"
"gml:AbstractFeature" <|-- "pml:Pipeline"
"pml:CoterminousComponent" <|-- "pml:Pump"
"pml:CoterminousComponent" <|-- "pml:Reducer"
"pml:AppurtenantComponent" <|-- "pml:Sleeve"
